# Codeberg Pages (git-pages) response headers for Duplex, the same policy as relay/wisp-relay.mjs:
# nothing is loaded from other sites; wss: is for the Wisp relays (the public ones or the user's
# own), ws://127.0.0.1 and ws://localhost for a relay on the user's computer.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' wss: ws://127.0.0.1:* ws://localhost:*; font-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
