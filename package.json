{
  "name": "duplex",
  "version": "0.1.0",
  "description": "Unofficial, privacy-focused web client for the SimpleX network that runs entirely in the browser",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:local": "node --import tsx --test --test-concurrency=1 test/local/*.test.ts",
    "relay": "node relay/wisp-relay.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "fzstd": "^0.1.1",
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.7"
  }
}
